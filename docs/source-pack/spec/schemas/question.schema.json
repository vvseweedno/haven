{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "status"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "INVESTIGATING",
        "PARTIALLY_RESOLVED",
        "RESOLVED",
        "REOPENED"
      ]
    }
  }
}