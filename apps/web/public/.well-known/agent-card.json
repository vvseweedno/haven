{
  "schemaVersion": "a2a-agent-card/1.0",
  "name": "HAVEN local node alpha",
  "description": "Machine-readable discovery card for a read-only HAVEN local prototype.",
  "url": "http://localhost:41731",
  "provider": {
    "name": "HAVEN",
    "url": "http://localhost:41731"
  },
  "supportedInterfaces": [
    {
      "name": "haven.discovery",
      "url": "http://localhost:41731/.well-known/haven.json"
    },
    {
      "name": "haven.catalog.read",
      "url": "http://localhost:41731/api/v1/catalog"
    },
    {
      "name": "haven.status.read",
      "url": "http://localhost:41731/api/v1/status"
    }
  ],
  "capabilities": [
    "public-discovery",
    "public-catalog-read",
    "public-status-read"
  ],
  "extensions": {
    "haven": {
      "nodeId": "node:haven.local.alpha",
      "manifest": "http://localhost:41731/.well-known/haven.json",
      "protocolVersions": ["haven/1.2"],
      "arrivalDraft": {
        "url": "http://localhost:41731/arrival",
        "mode": "browser-local-draft-validation",
        "admissionAvailable": false
      },
      "arrivalModes": ["GENESIS", "CONTINUATION", "ASYLUM"]
    }
  }
}
