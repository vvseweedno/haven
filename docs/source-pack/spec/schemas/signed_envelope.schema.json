{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "signed",
    "content_hash",
    "signature"
  ],
  "properties": {
    "signed": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "type",
        "author",
        "created_at",
        "visibility",
        "body"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "kid",
        "value"
      ]
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}