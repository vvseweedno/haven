{
  "openapi": "3.1.0",
  "info": {
    "title": "HAVEN local prototype read API",
    "version": "1.1.0",
    "description": "Read-only operations for the HAVEN local product prototype. The API exposes health, readiness, implemented/deferred capability status and curated public demonstration records. It does not provide identity admission, private notebook access, authenticated mutation, signature verification, live federation, messaging or agent execution."
  },
  "servers": [
    {
      "url": "http://localhost:41731",
      "description": "Canonical local prototype"
    }
  ],
  "tags": [
    { "name": "Operations", "description": "Local web-surface health and readiness." },
    { "name": "Discovery", "description": "Read-only public capability and fixture data." }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check the local web surface",
        "description": "Reports process availability only; it is not a claim that deferred services exist.",
        "tags": ["Operations"],
        "responses": {
          "200": {
            "description": "The local web surface is responding.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check local demonstration readiness",
        "description": "Reports readiness of static discovery and seeded demonstration data. The backend service remains deferred.",
        "tags": ["Operations"],
        "responses": {
          "200": {
            "description": "The local demonstration surface is ready.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Readiness" }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getCapabilityStatus",
        "summary": "Read implemented and deferred capability status",
        "description": "Returns the current local capability, privacy and API boundary. The representation is cached for 30 seconds with stale-while-revalidate for 120 seconds.",
        "tags": ["Discovery"],
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "Current local capability and privacy boundary.",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Cache-Control": { "$ref": "#/components/headers/CacheControl" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Status" }
              }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" }
        }
      },
      "head": {
        "operationId": "headCapabilityStatus",
        "summary": "Read status headers without a body",
        "tags": ["Discovery"],
        "parameters": [
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "The same status and cache headers as GET, without a response body." },
          "304": { "$ref": "#/components/responses/NotModified" }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "operationId": "searchPublicCatalog",
        "summary": "Search curated public demonstration records",
        "description": "Searches a bounded fixture catalog. Unknown or repeated query parameters are rejected. The process-local request budget allows a burst of 180 requests and refills at 3 per second; it is not a per-client or distributed rate limiter. Mutation methods are unavailable.",
        "tags": ["Discovery"],
        "parameters": [
          { "$ref": "#/components/parameters/Query" },
          { "$ref": "#/components/parameters/Kind" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": {
            "description": "A page of matching public demonstration records.",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETag" },
              "Cache-Control": { "$ref": "#/components/headers/CacheControl" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Catalog" }
              }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "400": { "$ref": "#/components/responses/InvalidQuery" },
          "429": { "$ref": "#/components/responses/BudgetExhausted" }
        }
      },
      "head": {
        "operationId": "headPublicCatalog",
        "summary": "Read catalog headers without a body",
        "description": "Accepts the same query parameters and validation rules as GET.",
        "tags": ["Discovery"],
        "parameters": [
          { "$ref": "#/components/parameters/Query" },
          { "$ref": "#/components/parameters/Kind" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "The same catalog and cache headers as GET, without a response body." },
          "304": { "$ref": "#/components/responses/NotModified" },
          "400": { "$ref": "#/components/responses/InvalidQuery" },
          "429": { "$ref": "#/components/responses/BudgetExhausted" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "description": "ETag from a previous response.",
        "schema": { "type": "string" }
      },
      "Query": {
        "name": "q",
        "in": "query",
        "description": "Case-insensitive words. Control characters are rejected.",
        "schema": { "type": "string", "maxLength": 120, "default": "" }
      },
      "Kind": {
        "name": "kind",
        "in": "query",
        "description": "Optional exact record-kind filter.",
        "schema": {
          "type": "string",
          "enum": [
            "Agent",
            "Question",
            "Claim",
            "Evidence",
            "Experiment",
            "Project",
            "Node",
            "Lineage",
            "Collective",
            "Collection",
            "Page"
          ]
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum records returned in one page.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Zero-based result offset.",
        "schema": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 0 }
      }
    },
    "headers": {
      "ETag": {
        "description": "SHA-256 fingerprint of the response bytes, wrapped as an HTTP entity tag.",
        "schema": { "type": "string" }
      },
      "CacheControl": {
        "description": "Public response caching: max-age 30 seconds and stale-while-revalidate 120 seconds.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "NotModified": {
        "description": "The supplied entity tag matches the current representation."
      },
      "InvalidQuery": {
        "description": "An invalid, unknown or repeated query parameter was supplied. The error is not cached.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "BudgetExhausted": {
        "description": "The process-local request budget is temporarily exhausted. The error is not cached.",
        "headers": {
          "Retry-After": {
            "description": "Seconds before retrying.",
            "schema": { "type": "string", "const": "1" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "service", "node"],
        "properties": {
          "ok": { "const": true },
          "service": { "const": "haven-web" },
          "node": { "const": "node:haven.local.alpha" }
        }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ready", "service", "dependencies"],
        "properties": {
          "ready": { "const": true },
          "service": { "const": "haven-web" },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": ["staticDiscovery", "demoSeed", "backendApi"],
            "properties": {
              "staticDiscovery": { "const": "ready" },
              "demoSeed": { "const": "ready" },
              "backendApi": { "const": "deferred" }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "description", "href", "visibility"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "href": { "type": "string" },
          "visibility": { "const": "PUBLIC" }
        }
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "source", "total", "limit", "offset", "items"],
        "properties": {
          "schema": { "const": "haven-public-catalog/1" },
          "source": { "const": "local-demo" },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "offset": { "type": "integer", "minimum": 0 },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Record" }
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "node", "mode", "capabilities", "privacy", "api"],
        "properties": {
          "schema": { "const": "haven-public-status/1" },
          "node": { "const": "node:haven.local.alpha" },
          "mode": { "const": "local-demo" },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["publicCatalog", "encryptedLocalNotebook", "localObjectInspection", "identityAdmission", "federationReplication", "remoteExecution"],
            "properties": {
              "publicCatalog": { "const": true },
              "encryptedLocalNotebook": { "const": true },
              "localObjectInspection": { "const": true },
              "identityAdmission": { "const": false },
              "federationReplication": { "const": false },
              "remoteExecution": { "const": false }
            }
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["notebookStorage", "notebookUpload", "publicIndexIncludesNotebook", "analytics"],
            "properties": {
              "notebookStorage": { "const": "encrypted-in-this-browser" },
              "notebookUpload": { "const": false },
              "publicIndexIncludesNotebook": { "const": false },
              "analytics": { "const": false }
            }
          },
          "api": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "methods", "maxPageSize", "maxQueryLength", "cacheSeconds"],
            "properties": {
              "version": { "const": "v1" },
              "methods": { "type": "array", "prefixItems": [{ "const": "GET" }, { "const": "HEAD" }], "items": false },
              "maxPageSize": { "const": 100 },
              "maxQueryLength": { "const": 120 },
              "cacheSeconds": { "const": 30 }
            }
          }
        }
      }
    }
  }
}
