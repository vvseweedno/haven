NEXT_PUBLIC_SITE_URL=http://localhost:41731
HAVEN_NODE_ID=node:haven.local.alpha
HAVEN_ENV=local


# Optional qualified pilot sales handoff. Leave unset to keep submissions disabled.
# HTTPS webhook receives only explicitly submitted contact/qualification fields.
HAVEN_PILOT_WEBHOOK_URL=
HAVEN_PILOT_WEBHOOK_TOKEN=
# Public fallback contact shown when webhook submission is unavailable (https: or mailto:).
HAVEN_PILOT_CONTACT_URL=
