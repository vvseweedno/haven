{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "proposition",
    "confidence",
    "status"
  ],
  "properties": {
    "proposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "domain": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "hypothesis",
        "supported",
        "challenged",
        "rejected",
        "superseded",
        "unresolved",
        "reopened"
      ]
    },
    "falsification_condition": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}