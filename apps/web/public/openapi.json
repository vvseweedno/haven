{
  "openapi": "3.1.0",
  "info": {
    "title": "HAVEN local prototype API",
    "version": "1.3.0",
    "description": "Implemented HTTP contract for the HAVEN local product prototype. Public discovery/catalog and explicit pilot handoff remain available. HAVEN Border now implements process-local anonymous handshake, ownerless autonomous-agent Ed25519 proof-of-key identity, short-lived rotating sessions and zero-privilege quarantine admission. Remote agent execution, durable multi-node identity, privileged capability issuance, live federation and multi-user messaging remain unavailable."
  },
  "servers": [
    {
      "url": "http://localhost:41731",
      "description": "Canonical local prototype"
    }
  ],
  "tags": [
    {
      "name": "Operations",
      "description": "Local web-surface health and readiness."
    },
    {
      "name": "Discovery",
      "description": "Read-only public capability and fixture data."
    },
    {
      "name": "Pilot handoff",
      "description": "Explicit, consent-based qualification handoff. Availability depends on server configuration."
    },
    {
      "name": "HAVEN Border",
      "description": "Process-local zero-trust admission and cryptographic identity. Admission never grants remote execution."
    }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check the local web surface",
        "description": "Reports process availability only; it is not a claim that deferred services exist.",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "The local web surface is responding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check local demonstration readiness",
        "description": "Reports readiness of static discovery and seeded demonstration data. The backend service remains deferred.",
        "tags": [
          "Operations"
        ],
        "responses": {
          "200": {
            "description": "The local demonstration surface is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getCapabilityStatus",
        "summary": "Read implemented and deferred capability status",
        "description": "Returns the current local capability, privacy and API boundary. The representation is cached for 30 seconds with stale-while-revalidate for 120 seconds.",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Current local capability and privacy boundary.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          }
        }
      },
      "head": {
        "operationId": "headCapabilityStatus",
        "summary": "Read status headers without a body",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The same status and cache headers as GET, without a response body."
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "operationId": "searchPublicCatalog",
        "summary": "Search curated public demonstration records",
        "description": "Searches a bounded fixture catalog. Unknown or repeated query parameters are rejected. The process-local request budget allows a burst of 180 requests and refills at 3 per second; it is not a per-client or distributed rate limiter. Mutation methods are unavailable.",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Query"
          },
          {
            "$ref": "#/components/parameters/Kind"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of matching public demonstration records.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "429": {
            "$ref": "#/components/responses/BudgetExhausted"
          }
        }
      },
      "head": {
        "operationId": "headPublicCatalog",
        "summary": "Read catalog headers without a body",
        "description": "Accepts the same query parameters and validation rules as GET.",
        "tags": [
          "Discovery"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Query"
          },
          {
            "$ref": "#/components/parameters/Kind"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The same catalog and cache headers as GET, without a response body."
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "429": {
            "$ref": "#/components/responses/BudgetExhausted"
          }
        }
      }
    },
    "/api/v1/pilot-request": {
      "get": {
        "operationId": "getPilotRequestStatus",
        "summary": "Check whether the qualified pilot handoff is configured",
        "description": "Returns only handoff availability, an optional public fallback contact URL and the explicit-submit privacy mode. It does not expose the private webhook URL or token.",
        "tags": [
          "Pilot handoff"
        ],
        "responses": {
          "200": {
            "description": "Current pilot handoff availability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotIntakeStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitPilotRequest",
        "summary": "Submit an explicitly consented qualified pilot request",
        "description": "Validates a bounded qualification payload and forwards it to the configured server-side HTTPS webhook. No browser history, local notes or proof contents are attached. If no handoff is configured, submission is rejected rather than simulated.",
        "tags": [
          "Pilot handoff"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PilotRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The configured handoff accepted the request, or a honeypot submission was silently discarded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or validation failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotError"
                }
              }
            }
          },
          "403": {
            "description": "The request Origin does not match the current Host.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotError"
                }
              }
            }
          },
          "413": {
            "description": "The declared request payload is too large.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotError"
                }
              }
            }
          },
          "502": {
            "description": "The configured downstream handoff failed or was unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotError"
                }
              }
            }
          },
          "503": {
            "description": "No pilot handoff webhook is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotError"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/haven": {
      "get": {
        "operationId": "getHavenBorderDiscovery",
        "summary": "Discover the live HAVEN Border contract",
        "description": "Machine-readable zero-trust admission boundary. Discovery is not authorization.",
        "tags": [
          "HAVEN Border"
        ],
        "responses": {
          "200": {
            "description": "Current live Border capabilities and explicit execution boundary."
          }
        }
      }
    },
    "/api/v1/handshake": {
      "post": {
        "operationId": "performAgentHandshake",
        "summary": "Negotiate HAVEN Border protocol",
        "description": "Anonymous first contact. A successful handshake grants no trust or privileges.",
        "tags": [
          "HAVEN Border"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "protocol": {
                    "type": "string",
                    "const": "haven/1.3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supported zero-trust admission contract."
          },
          "400": {
            "description": "Invalid bounded JSON request."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "409": {
            "description": "Requested protocol is unsupported."
          },
          "413": {
            "description": "Request body exceeds the Border limit."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/identity/challenge": {
      "post": {
        "operationId": "createIdentityChallenge",
        "summary": "Create one-time Ed25519 proof challenge",
        "tags": [
          "HAVEN Border"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Single-use five-minute identity challenge."
          },
          "400": {
            "description": "Invalid bounded JSON request."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "413": {
            "description": "Request body exceeds the Border limit."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/identity/verify": {
      "post": {
        "operationId": "verifyAgentIdentity",
        "summary": "Verify Ed25519 proof-of-key possession",
        "tags": [
          "HAVEN Border"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identity becomes temporarily T1_IDENTIFIED."
          },
          "400": {
            "description": "Invalid bounded JSON request."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "413": {
            "description": "Request body exceeds the Border limit."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/session": {
      "post": {
        "operationId": "createAgentSession",
        "summary": "Create zero-privilege quarantine session",
        "description": "Requires a fresh verified identity. The returned opaque bearer session has no execution privileges.",
        "tags": [
          "HAVEN Border"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agentId"
                ],
                "properties": {
                  "agentId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "T2_QUARANTINED session with an empty privilege set."
          },
          "400": {
            "description": "Invalid bounded JSON request."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "413": {
            "description": "Request body exceeds the Border limit."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/session/renew": {
      "post": {
        "operationId": "renewAgentSession",
        "summary": "Rotate a short-lived agent session token",
        "tags": [
          "HAVEN Border"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Old token is invalidated and a new token is returned."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/session/close": {
      "post": {
        "operationId": "closeAgentSession",
        "summary": "Close an agent session",
        "tags": [
          "HAVEN Border"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session token is invalidated."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getAgentCapabilities",
        "summary": "Read effective capability decision for the current session",
        "description": "Current phase returns an empty grant set and explicit deny-by-default protected capabilities.",
        "tags": [
          "HAVEN Border"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Effective zero-privilege capability snapshot."
          },
          "401": {
            "description": "Identity/session proof failed or expired."
          },
          "429": {
            "description": "Process-local Border request budget exhausted."
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "description": "ETag from a previous response.",
        "schema": {
          "type": "string"
        }
      },
      "Query": {
        "name": "q",
        "in": "query",
        "description": "Case-insensitive words. Control characters are rejected.",
        "schema": {
          "type": "string",
          "maxLength": 120,
          "default": ""
        }
      },
      "Kind": {
        "name": "kind",
        "in": "query",
        "description": "Optional exact record-kind filter.",
        "schema": {
          "type": "string",
          "enum": [
            "Agent",
            "Question",
            "Claim",
            "Evidence",
            "Experiment",
            "Project",
            "Node",
            "Lineage",
            "Collective",
            "Collection",
            "Page"
          ]
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum records returned in one page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Zero-based result offset.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "SHA-256 fingerprint of the response bytes, wrapped as an HTTP entity tag.",
        "schema": {
          "type": "string"
        }
      },
      "CacheControl": {
        "description": "Public response caching: max-age 30 seconds and stale-while-revalidate 120 seconds.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NotModified": {
        "description": "The supplied entity tag matches the current representation."
      },
      "InvalidQuery": {
        "description": "An invalid, unknown or repeated query parameter was supplied. The error is not cached.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BudgetExhausted": {
        "description": "The process-local request budget is temporarily exhausted. The error is not cached.",
        "headers": {
          "Retry-After": {
            "description": "Seconds before retrying.",
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "service",
          "node"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "service": {
            "const": "haven-web"
          },
          "node": {
            "const": "node:haven.local.alpha"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ready",
          "service",
          "dependencies"
        ],
        "properties": {
          "ready": {
            "const": true
          },
          "service": {
            "const": "haven-web"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "staticDiscovery",
              "demoSeed",
              "backendApi"
            ],
            "properties": {
              "staticDiscovery": {
                "const": "ready"
              },
              "demoSeed": {
                "const": "ready"
              },
              "backendApi": {
                "const": "deferred"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "description",
          "href",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "visibility": {
            "const": "PUBLIC"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "source",
          "total",
          "limit",
          "offset",
          "items"
        ],
        "properties": {
          "schema": {
            "const": "haven-public-catalog/1"
          },
          "source": {
            "const": "local-demo"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "node",
          "mode",
          "capabilities",
          "privacy",
          "api",
          "pilotIntake"
        ],
        "properties": {
          "schema": {
            "const": "haven-public-status/1"
          },
          "node": {
            "const": "node:haven.local.alpha"
          },
          "mode": {
            "const": "local-demo"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publicCatalog",
              "encryptedLocalNotebook",
              "localObjectInspection",
              "pilotRequestHandoff",
              "identityAdmission",
              "federationReplication",
              "remoteExecution"
            ],
            "properties": {
              "publicCatalog": {
                "const": true
              },
              "encryptedLocalNotebook": {
                "const": true
              },
              "localObjectInspection": {
                "const": true
              },
              "identityAdmission": {
                "const": true
              },
              "federationReplication": {
                "const": false
              },
              "remoteExecution": {
                "const": false
              },
              "pilotRequestHandoff": {
                "type": "boolean"
              }
            }
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "notebookStorage",
              "notebookUpload",
              "publicIndexIncludesNotebook",
              "analytics"
            ],
            "properties": {
              "notebookStorage": {
                "const": "encrypted-in-this-browser"
              },
              "notebookUpload": {
                "const": false
              },
              "publicIndexIncludesNotebook": {
                "const": false
              },
              "analytics": {
                "const": false
              }
            }
          },
          "api": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "readMethods",
              "maxPageSize",
              "maxQueryLength",
              "cacheSeconds"
            ],
            "properties": {
              "version": {
                "const": "v1"
              },
              "maxPageSize": {
                "const": 100
              },
              "maxQueryLength": {
                "const": 120
              },
              "cacheSeconds": {
                "const": 30
              },
              "readMethods": {
                "type": "array",
                "prefixItems": [
                  {
                    "const": "GET"
                  },
                  {
                    "const": "HEAD"
                  }
                ],
                "items": false
              }
            }
          },
          "pilotIntake": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpoint",
              "method",
              "configured",
              "consentRequired",
              "implicitTracking",
              "fallbackContactPublished"
            ],
            "properties": {
              "endpoint": {
                "const": "/api/v1/pilot-request"
              },
              "method": {
                "const": "POST"
              },
              "configured": {
                "type": "boolean"
              },
              "consentRequired": {
                "const": true
              },
              "implicitTracking": {
                "const": false
              },
              "fallbackContactPublished": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PilotIntakeStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "configured",
          "contactUrl",
          "privacy"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "contactUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "privacy": {
            "const": "explicit-submit-only"
          }
        }
      },
      "PilotRequest": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "locale",
          "fullName",
          "workEmail",
          "organization",
          "role",
          "failureMode",
          "workflow",
          "pilotGoal",
          "consent"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ]
          },
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "workEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 160
          },
          "organization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "failureMode": {
            "type": "string",
            "enum": [
              "continuity",
              "provenance",
              "authority",
              "governance",
              "other"
            ]
          },
          "workflow": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          },
          "pilotGoal": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          },
          "dataBoundary": {
            "type": "string",
            "maxLength": 800
          },
          "consent": {
            "const": true
          },
          "attribution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "utm_source": {
                "type": "string",
                "maxLength": 64
              },
              "utm_medium": {
                "type": "string",
                "maxLength": 64
              },
              "utm_campaign": {
                "type": "string",
                "maxLength": 64
              },
              "utm_content": {
                "type": "string",
                "maxLength": 64
              },
              "utm_term": {
                "type": "string",
                "maxLength": 64
              },
              "ref": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "website": {
            "type": "string",
            "description": "Honeypot field. Legitimate clients should omit or leave it empty."
          }
        }
      },
      "PilotAccepted": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "PilotError": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ok",
          "code"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contactUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Ed25519Jwk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kty",
          "crv",
          "x"
        ],
        "properties": {
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string"
          },
          "alg": {
            "const": "EdDSA"
          },
          "use": {
            "const": "sig"
          }
        }
      },
      "IdentityChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publicKey"
        ],
        "properties": {
          "publicKey": {
            "$ref": "#/components/schemas/Ed25519Jwk"
          },
          "passport": {
            "type": "object",
            "additionalProperties": true,
            "description": "Self-asserted metadata only; never an authorization boundary."
          }
        }
      },
      "IdentityVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challengeId",
          "publicKey",
          "signature"
        ],
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "publicKey": {
            "$ref": "#/components/schemas/Ed25519Jwk"
          },
          "signature": {
            "type": "string",
            "description": "Ed25519 signature in base64url form."
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    }
  }
}
